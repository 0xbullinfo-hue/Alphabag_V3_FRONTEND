{
  "name": "alphabag-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "verify:crawlability": "node scripts/verify-crawlability.cjs",
    "generate:openapi-types": "node scripts/generate-types-from-openapi.js",
    "verify:openapi-types": "node scripts/generate-types-from-openapi.js && git diff --exit-code src/types/openapi-contracts.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@types/dompurify": "^3.0.5",
    "@vitest/runner": "^4.1.11",
    "@web3modal/wagmi": "^3.5.7",
    "axios": "1.6.7",
    "dompurify": "^3.4.14",
    "framer-motion": "^12.35.2",
    "lucide-react": "0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.22.1",
    "recharts": "2.12.1",
    "remark-gfm": "^4.0.1",
    "sweetalert2": "^11.26.18",
    "viem": "^1.21.3",
    "vite-plugin-node-polyfills": "^0.25.0",
    "wagmi": "^1.4.13",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jimp": "^1.6.1",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^5.1.4",
    "vitest": "^4.1.11",
    "yarn": "^1.22.22"
  }
}
