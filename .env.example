# === API ===
VITE_API_BASE_URL=https://api.alphabag.pro

# === Analytics ===
# Optional GA4 measurement ID. Analytics only loads in production after consent.
VITE_GA_MEASUREMENT_ID=

# === WalletConnect ===
VITE_WALLETCONNECT_PROJECT_ID=

# === Launch Mode ===
VITE_LAUNCH_MODE=full
# VITE_LAUNCH_MODE=teaser

# === Data Mode ===
VITE_DATA_MODE=LIVE
# VITE_DATA_MODE=AUTO
# VITE_DATA_MODE=MOCK

# === Feature Flags (fallbacks only — backend is source of truth) ===
VITE_ENABLE_TOKEN_GATING=false
VITE_ENVIRONMENT=mainnet



# === BACKEND-PROXIED SERVICES (keys stored server-side only) ===
# The following services are proxied through the backend API.
# Their keys must NEVER be exposed in the frontend bundle.
#
# COVALENT_API_KEY      → /api/security/approvals
# ALCHEMY_API_KEY       → /api/rpc/*
# COINGECKO_API_KEY     → /api/market/*
# DEXSCREENER_API_KEY   → /api/dex/*
# MORALIS_API_KEY       → /api/whales/*
# GEMINI_API_KEY        → /api/ai/*
# BINANCE_API_KEY       → /api/market/binance/*
