+import { useMemo, useState } from 'react';
+import { buildBubblemapsIframeUrl } from '../../services/bubblemaps';
+
+interface BubblemapsEmbedProps {
+  chain: string;
+  address: string;
+  height?: number;
+}
+
+export function BubblemapsEmbed({
+  chain,
+  address,
+  height = 640,
+}: BubblemapsEmbedProps) {
+  const [loading, setLoading] = useState(true);
+  const src = useMemo(
+    () => buildBubblemapsIframeUrl(chain, address),
+    [chain, address],
+  );
+
+  return (
+    <div className="relative w-full overflow-hidden rounded-xl border border-white/10 bg-slate-900/40">
+      {loading && (
+        <div className="absolute inset-0 z-10 flex items-center justify-center text-sm text-slate-400">
+          Loading bubble map…
+        </div>
+      )}
+      <iframe
+        key={src}
+        src={src}
+        title={`Bubble map for ${address}`}
+        allow="clipboard-write"
+        loading="lazy"
+        onLoad={() => setLoading(false)}
+        style={{ width: '100%', height, border: 'none' }}
+      />
+    </div>
+  );
+}
+
+export default BubblemapsEmbed;

