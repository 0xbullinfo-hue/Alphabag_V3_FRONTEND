+const BUBBLEMAPS_API_BASE = 'https://api.bubblemaps.io/v0';
+
+function getPartnerId(): string {
+  return import.meta.env.VITE_BUBBLEMAPS_PARTNER_ID ?? 'demo';
+}
+
+/**
+ * Build the URL for the Bubblemaps iframe embed.
+ * Docs: https://docs.bubblemaps.io
+ */
+export function buildBubblemapsIframeUrl(
+  chain: string,
+  address: string,
+  partnerId: string = getPartnerId(),
+): string {
+  const params = new URLSearchParams({
+    chain,
+    address,
+    partnerId,
+  });
+  return `https://iframe.bubblemaps.io/map?${params.toString()}`;
+}
+
+/**
+ * Optional: fetch raw map metadata from the Bubblemaps Data API.
+ * Requires VITE_BUBBLEMAPS_API_KEY.
+ */
+export async function fetchBubblemapsMetadata(
+  chain: string,
+  address: string,
+): Promise<unknown | null> {
+  const apiKey = import.meta.env.VITE_BUBBLEMAPS_API_KEY;
+  if (!apiKey) return null;
+
+  const url = `${BUBBLEMAPS_API_BASE}/tokens/${chain}/${address}/metadata`;
+  const res = await fetch(url, { headers: { 'X-ApiKey': apiKey } });
+  if (!res.ok) throw new Error(`Bubblemaps ${res.status}: ${res.statusText}`);
+  return res.json();
+}

diff --git a/src/services/santiment.ts b/src/services/santiment.ts
new file mode 100644
--- /dev/null
+++ b/src/services/santiment.ts
@@ -0,0 +1,104 @@
+import type {
+  SocialMetrics,
+  SocialVolumePoint,
+  TrendingWord,
+} from '../types/intelligence';
+
+const SANTIMENT_ENDPOINT = 'https://api.santiment.net/graphql';
+
+function getApiKey(): string {
+  const key = import.meta.env.VITE_SANTIMENT_API_KEY;
+  if (!key) {
+    console.warn(
+      '[Santiment] VITE_SANTIMENT_API_KEY is not set. Requests may be rate-limited.',
+    );
+  }
+  return key ?? '';
+}
+
+async function gql<T>(
+  query: string,
+  variables: Record<string, unknown>,
+): Promise<T> {
+  const apiKey = getApiKey();
+  const res = await fetch(SANTIMENT_ENDPOINT, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      ...(apiKey ? { Authorization: `Apikey ${apiKey}` } : {}),
+    },
+    body: JSON.stringify({ query, variables }),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Santiment ${res.status}: ${res.statusText}`);
+  }
+
+  const json = (await res.json()) as {
+    data?: T;
+    errors?: Array<{ message: string }>;
+  };
+
+  if (json.errors?.length) {
+    throw new Error(`Santiment GraphQL: ${json.errors[0].message}`);
+  }
+  if (!json.data) {
+    throw new Error('Santiment returned no data');
+  }
+  return json.data;
+}
+
+export async function fetchTrendingWords(
+  fromISO: string,
+  toISO: string,
+  size = 8,
+): Promise<TrendingWord[]> {
+  const query = `
+    query TrendingWords($from: DateTime!, $to: DateTime!, $size: Int!) {
+      getTrendingWords(from: $from, to: $to, size: $size, interval: "1h") {
+        topWords {
+          word
+          score
+        }
+      }
+    }
+  `;
+  const data = await gql<{
+    getTrendingWords: Array<{ topWords: TrendingWord[] }>;
+  }>(query, { from: fromISO, to: toISO, size });
+
+  const latest = data.getTrendingWords?.[0];
+  return latest?.topWords ?? [];
+}
+
+export async function fetchSocialVolume(
+  assetSlug: string,
+  fromISO: string,
+  toISO: string,
+): Promise<SocialVolumePoint[]> {
+  const query = `
+    query SocialVolume($slug: String!, $from: DateTime!, $to: DateTime!) {
+      getMetric(metric: "social_volume_total") {
+        timeseriesData(slug: $slug, from: $from, to: $to, interval: "1h") {
+          datetime
+          value
+        }
+      }
+    }
+  `;
+  const data = await gql<{
+    getMetric: { timeseriesData: SocialVolumePoint[] };
+  }>(query, { slug: assetSlug, from: fromISO, to: toISO });
+
+  return data.getMetric?.timeseriesData ?? [];
+}
+
+export async function fetchSentimentBalance(
+  assetSlug: string,
+  fromISO: string,
+  toISO: string,
+): Promise<number | null> {
+  const query = `
+    query SentimentBalance($slug: String!, $from: DateTime!, $to: DateTime!) {
+      getMetric(metric: "sentiment_balance_total") {
+        timeseriesData(slug: $slug, from: $from, to: $to, interval: "1h") {
+          datetime
+          value
+        }
+      }
+    }
+  `;
+  const data = await gql<{
+    getMetric: { timeseriesData: SocialVolumePoint[] };
+  }>(query, { slug: assetSlug, from: fromISO, to: toISO });
+
+  const series = data.getMetric?.timeseriesData ?? [];
+  return series.length ? series[series.length - 1].value : null;
+}
+
+export async function fetchSocialMetrics(
+  assetSlug: string,
+  fromISO: string,
+  toISO: string,
+): Promise<SocialMetrics> {
+  const [trendingWords, socialVolume, sentimentBalance] = await Promise.all([
+    fetchTrendingWords(fromISO, toISO, 8).catch(() => [] as TrendingWord[]),
+    fetchSocialVolume(assetSlug, fromISO, toISO).catch(
+      () => [] as SocialVolumePoint[],
+    ),
+    fetchSentimentBalance(assetSlug, fromISO, toISO).catch(() => null),
+  ]);
+
+  return { trendingWords, socialVolume, sentimentBalance };
+}

