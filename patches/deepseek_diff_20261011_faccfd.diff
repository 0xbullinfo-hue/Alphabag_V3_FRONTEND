+import { useState } from 'react';
+import { BubblemapsEmbed } from '../components/intelligence/BubblemapsEmbed';
+import { TradingViewChart } from '../components/intelligence/TradingViewChart';
+import { SantimentMetrics } from '../components/intelligence/SantimentMetrics';
+import type { TokenContext } from '../types/intelligence';
+
+const PRESETS: TokenContext[] = [
+  {
+    label: 'BTC / USDT',
+    tvSymbol: 'BINANCE:BTCUSDT',
+    chain: 'eth',
+    address: '0x2260fac5e5542a773aa44fbcfedf7c193bc2c599',
+    assetSlug: 'bitcoin',
+  },
+  {
+    label: 'ETH / USDT',
+    tvSymbol: 'BINANCE:ETHUSDT',
+    chain: 'eth',
+    address: '0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2',
+    assetSlug: 'ethereum',
+  },
+  {
+    label: 'SOL / USDT',
+    tvSymbol: 'BINANCE:SOLUSDT',
+    chain: 'solana',
+    address: 'So11111111111111111111111111111111111111112',
+    assetSlug: 'solana',
+  },
+];
+
+export default function IntelligenceTerminal() {
+  const [preset, setPreset] = useState<TokenContext>(PRESETS[0]);
+  const [addressInput, setAddressInput] = useState(PRESETS[0].address);
+
+  const handlePresetChange = (label: string) => {
+    const next = PRESETS.find((p) => p.label === label) ?? PRESETS[0];
+    setPreset(next);
+    setAddressInput(next.address);
+  };
+
+  return (
+    <div className="mx-auto w-full max-w-[1600px] px-4 py-6">
+      <header className="mb-6">
+        <h1 className="text-2xl font-semibold text-white">
+          Intelligence Terminal
+        </h1>
+        <p className="mt-1 text-sm text-slate-400">
+          Price action, on-chain distribution, and social sentiment — in one
+          view.
+        </p>
+      </header>
+
+      <div className="mb-4 flex flex-wrap items-center gap-3">
+        <select
+          value={preset.label}
+          onChange={(e) => handlePresetChange(e.target.value)}
+          className="rounded-lg border border-white/10 bg-slate-900/60 px-3 py-2 text-sm text-white"
+        >
+          {PRESETS.map((p) => (
+            <option key={p.label} value={p.label}>
+              {p.label}
+            </option>
+          ))}
+        </select>
+
+        <input
+          value={addressInput}
+          onChange={(e) => setAddressInput(e.target.value)}
+          placeholder="Token contract address"
+          className="min-w-[320px] flex-1 rounded-lg border border-white/10 bg-slate-900/60 px-3 py-2 text-sm text-white placeholder:text-slate-500"
+        />
+      </div>
+
+      <div className="grid grid-cols-1 gap-4 xl:grid-cols-5">
+        <div className="xl:col-span-3">
+          <TradingViewChart symbol={preset.tvSymbol} height={640} />
+        </div>
+        <div className="xl:col-span-2">
+          <BubblemapsEmbed
+            chain={preset.chain}
+            address={addressInput}
+            height={640}
+          />
+        </div>
+      </div>
+
+      <div className="mt-4">
+        <SantimentMetrics assetSlug={preset.assetSlug} />
+      </div>
+    </div>
+  );
+}